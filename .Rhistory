```{r, fig.width=15, fig.height=10}
for (i in 1:6){
plot(dat[dat$ID == i,]$running_accuracy, ylim = c(0.65, 1), type = "l", xlab = "Trial",
ylab = "Accuracy")
}
group1 <- c(1, 3, 5)  # red
group2 <- c(2, 4)     # blue
get_group_matrix <- function(ids, colname) {
do.call(cbind, lapply(ids, function(i) dat[dat$ID == i, colname]))
}
# --- Running accuracy plot ---
run1 <- get_group_matrix(group1, "running_accuracy")
run2 <- get_group_matrix(group2, "running_accuracy")
run1_avg <- rowMeans(run1, na.rm = TRUE)
run2_avg <- rowMeans(run2, na.rm = TRUE)
plot(run1_avg, type = "l", col = "red", ylim = c(0.65, 1),
xlab = "Trial", ylab = "Running Accuracy", main = "Running Accuracy by Group")
lines(run2_avg, col = "blue")
legend("bottomright", legend = c("Subjects 1,3,5", "Subjects 2,4"),
col = c("red", "blue"), lty = 1)
# --- Overall accuracy plot ---
ov1 <- get_group_matrix(group1, "overall_accuracy")
ov2 <- get_group_matrix(group2, "overall_accuracy")
ov1_avg <- rowMeans(ov1, na.rm = TRUE)
ov2_avg <- rowMeans(ov2, na.rm = TRUE)
plot(ov1_avg, type = "l", col = "red", ylim = c(0.8, 1),
xlab = "Trial", ylab = "Overall Accuracy", main = "Overall Accuracy by Group")
lines(ov2_avg, col = "blue")
legend("bottomright", legend = c("Subjects 1,3,5", "Subjects 2,4"),
col = c("red", "blue"), lty = 1)
plot(ov1_avg, type = "l", col = "red", ylim = c(0.8, 1),
xlab = "Trial", ylab = "Overall Accuracy", main = "Overall Accuracy by Group")
lines(ov2_avg, col = "blue")
legend("bottomright", legend = c("Subjects 1,3,5", "Subjects 2,4"),
col = c("red", "blue"), lty = 1)
legend("bottomright", legend = c("Subjects 1,3,5", "Subjects 2,4"),
col = c("red", "blue"), lty = 1)
# --- Overall accuracy plot ---
ov1 <- get_group_matrix(group1, "overall_accuracy")
plot(run1_avg, type = "l", col = "red", ylim = c(0.65, 1),
xlab = "Trial", ylab = "Running Accuracy", main = "Running Accuracy by Group")
lines(run2_avg, col = "blue")
